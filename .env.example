# Da3m.ma — environment variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# Source of truth: docs/devops-da3m.md section 5. Keys marked [S1] block Sprint 1.

# --- Database [S1] (local Docker works: postgres://da3m:da3m@localhost:5433/da3m — run pnpm db:up) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth: Clerk [S1] ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Cron + source watcher [S2] ---
CRON_SECRET=
WATCH_ALLOWED_HOSTS=www.tamwilcom.ma,www.tamwilstartups.ma,marocpme.gov.ma,www.forsa.ma
WATCH_USER_AGENT=Da3mBot/1.0 (+https://da3m.ma/bot)

# --- Rate limiting [public beta] — in-process limiter until then (ADR-9) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email + site [S4] ---
RESEND_API_KEY=
EMAIL_FROM=Da3m.ma <alertes@da3m.ma>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Monitoring [S6] ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Billing [S6] ---
CMI_CLIENT_ID=
CMI_STORE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
